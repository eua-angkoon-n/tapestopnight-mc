# Copy to .env and fill in. .env is gitignored (ADR-0010) — never commit it.
# Every key the system reads is listed here with an empty value.

# ── Discord (ADR-0004, ADR-0008) ────────────────────────────────────
# NOTE ADR-0008: this reuses the DISCO NIGHT application's credentials.
# DISCO NIGHT must be STOPPED before the new bot connects — Discord allows
# only one gateway session per token. Rotate this token after cutover.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# The role that grants admin on BOTH the web UI and the bot (ADR-0004).
DISCORD_ADMIN_ROLE_ID=

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://tapestopnight.com

# ── Postgres (not port-published to the Host) ───────────────────────
POSTGRES_USER=tapestopnight
POSTGRES_PASSWORD=
POSTGRES_DB=tapestopnight
DATABASE_URL=

# ── Game Server / RCON ──────────────────────────────────────────────
# RCON binds to the internal Docker network only. 25575 is NEVER published.
RCON_HOST=mc
RCON_PORT=25575
RCON_PASSWORD=
# Server List Ping target — how status is read (never RCON). See design notes.
MC_SLP_HOST=mc
MC_SLP_PORT=25565

# ── Container control (ADR-0005) ────────────────────────────────────
# The socket-proxy, scoped to start/stop/restart/inspect on this container.
# Never the raw /var/run/docker.sock.
MC_CONTAINER_NAME=mc
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# ── Memory (ADR-0011) ───────────────────────────────────────────────
# 4G, deliberately below the modpack's 6G recommendation. Read ADR-0011
# before changing this. Raise to 6G ONLY for a pregen run with the web app
# and bot stopped, then put it back.
MC_MEMORY=4G
