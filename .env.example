# Copy to .env and fill in. .env is gitignored (ADR-0010) — never commit it.
# Every key the system reads is listed here with an empty value.

# ── Discord (ADR-0004, ADR-0008) ────────────────────────────────────
# NOTE ADR-0008: this reuses the DISCO NIGHT application's credentials.
# DISCO NIGHT must be STOPPED before the new bot connects — Discord allows
# only one gateway session per token. Rotate this token after cutover.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# The role that grants admin on BOTH the web UI and the bot (ADR-0004).
DISCORD_ADMIN_ROLE_ID=

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://tapestopnight.com
# Behind Caddy, so Auth.js must trust the forwarded host headers.
AUTH_TRUST_HOST=true

# Auth.js reads the Discord provider from AUTH_DISCORD_* specifically; the
# DISCORD_CLIENT_* names above are what deploy/docker-compose.yml maps from.
#
# Role revocation is not instant, by design and stated plainly: a cached role
# set is re-checked against Discord every 5 minutes and a session lives at most
# 12 hours. Independently of both, every mutating admin action re-checks
# authorisation server-side before doing anything.

# ── Postgres (deliberately NOT port-published; reached as host `db`) ─
# 16-alpine, matching the PostgreSQL 16 the family-ledger project already runs
# on this Host, so backups and upgrades have one mental model.
POSTGRES_USER=tapestopnight
POSTGRES_PASSWORD=
POSTGRES_DB=tapestopnight
# Host `db` resolves on the compose network. Nothing outside it can connect.
DATABASE_URL=postgres://tapestopnight:CHANGEME@db:5432/tapestopnight

# ── Game Server / RCON ──────────────────────────────────────────────
# RCON binds to the internal Docker network only. 25575 is NEVER published.
RCON_HOST=mc
RCON_PORT=25575
RCON_PASSWORD=
# Server List Ping target — how status is read (never RCON). See design notes.
MC_SLP_HOST=mc
MC_SLP_PORT=25565

# ── Container control (ADR-0005) ────────────────────────────────────
# The socket-proxy, scoped to start/stop/restart/inspect on this container.
# Never the raw /var/run/docker.sock.
MC_CONTAINER_NAME=mc
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# ── Discord bot (Phase 6) ───────────────────────────────────────────
# Where the Game Server reads its files. The bot mounts this read-write
# because /config apply renders server.properties and server-icon.png into it
# — the same known privilege the web container carries, recorded in the
# compose file rather than glossed over.
PACK_DIR=/pack
# Used in /info replies so players are told one address, the same one the
# website shows.
PUBLIC_BASE_URL=https://tapestopnight.com
# Lead time announced in-game before a restart, stop or apply actually
# happens. 0 disables the countdown entirely; `now: True` skips it per call.
RESTART_COUNTDOWN_SECONDS=30

# ── Memory ──────────────────────────────────────────────────────────
# 8G, chosen for Homestead and NOT yet measured on it. ADR-0012's 7G was
# measured on Forge 1.12.2 under Java 8, which this server no longer runs.
# The pack's own docs ask for 8-12 GB; this Host has 12 GB and shares it, so
# 8G is the ceiling rather than a comfortable middle.
# Measure RSS once the server is up and idle. Above ~9.6 GiB (96% of the 10g
# mem_limit) drop back to 7G — do not raise mem_limit to make the number fit.
# Do not remove the Aikar flags or the GC logging; they are the mitigation.
MC_MEMORY=8G
