{
  "name": "tapestopnight-mc",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "db:generate": "drizzle-kit generate --config=db/drizzle.config.ts",
    "db:migrate": "node --experimental-strip-types db/migrate.ts",
    "db:seed": "node --experimental-strip-types db/seed/seed.ts",
    "render:check": "node --experimental-strip-types db/render-check.ts",
    "icon:check": "node --experimental-strip-types packages/core/icon-check.ts",
    "bot:check": "node --experimental-strip-types apps/bot/tree-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
