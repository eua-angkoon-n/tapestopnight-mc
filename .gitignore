# ── Secrets (ADR-0010) ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
id_ed25519*
id_rsa*

# ── Generated config: ADR-0002 build artifacts, NOT source ──────────
# server.properties is rendered from Postgres. Committing it would invite
# the hand-editing ADR-0002 forbids.
server.properties
server-icon.png
eula.txt

# ── Vendor payload: ADR-0009 keeps this out, pinned by SHA256 ───────
*.zip
mods/
libraries/
resources/
structures/
resourcepacks/
shaderpacks/
fancymenu_data/
changelogs/
options.txt
optionsof.txt
optionsshaders.txt
# NOTE: overlay/config and overlay/scripts ARE tracked — only the
# unpacked vendor config/ and scripts/ trees are ignored.
/config/
/scripts/

# ── World and runtime state ─────────────────────────────────────────
Homestead/
world*/
logs/
crash-reports/
backups/
uploads/
*.log

# ── Node ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo
.pnpm-store/

# Site media (ADR-0009): the hero video and stills live on the Host at
# /srv/mc/media and are bind-mounted in. A 30 MB mp4 in git would make every
# clone carry every re-encode for ever.
apps/web/public/media/

# Media staged for upload to /srv/mc/media on the Host. Same reason as
# apps/web/public/media/ above (ADR-0009): this is payload, not source. It is
# a staging area, not a second home for the files.
.media-staging/
