#!/bin/sh
# Refuse a direct push to main.
#
# This is the local stand-in for the branch ruleset in .github/rulesets/main.json,
# which GitHub will not apply while this repository is private on a free personal
# account. See .github/rulesets/README.md.
#
# Be honest about what this is: one laptop, no server behind it, and `--no-verify`
# walks straight past it. It is aimed at the mistake that actually happens here —
# `git push` while still standing on main — not at anybody determined to bypass it.
#
# Enable once per clone (git does not install hooks from a checkout):
#
#     git config core.hooksPath .githooks
#
# stdin is one line per ref being pushed:
#     <local ref> <local sha> <remote ref> <remote sha>

set -eu

PROTECTED='refs/heads/main'
ZERO='0000000000000000000000000000000000000000'

remote_name="${1:-origin}"

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "${remote_ref}" = "${PROTECTED}" ] || continue

    # A zeroed local sha means "delete the remote branch". Worth naming
    # separately: the generic message below would read as nonsense for it.
    if [ "${local_sha}" = "${ZERO}" ]; then
        echo "pre-push: refusing to DELETE ${remote_ref} on ${remote_name}." >&2
        blocked=1
        continue
    fi

    echo "pre-push: refusing to push directly to ${remote_ref} on ${remote_name}." >&2
    echo "          main is built from merged pull requests, so that CI runs on the" >&2
    echo "          change before it reaches the branch the Host deploys from." >&2
    blocked=1
done

if [ "${blocked}" -eq 1 ]; then
    current="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo 'a detached HEAD')"
    echo >&2
    echo "  You are on: ${current}" >&2
    echo >&2
    echo "  Open a pull request instead:" >&2
    echo "      git switch -c some-branch      # if you are on main" >&2
    echo "      git push -u ${remote_name} HEAD" >&2
    echo "      gh pr create --fill" >&2
    echo >&2
    echo "  If you genuinely mean to push to main, say so deliberately:" >&2
    echo "      git push --no-verify ${remote_name} main" >&2
    exit 1
fi

exit 0
